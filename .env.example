# ============================================================
# ForgeLoop Environment Configuration
# ============================================================

# Groq API Key (Optional)
# If set, ForgeLoop uses Groq's Llama 3.3 70B for real-time natural language
# intent compilation and surgical level repair.
# If omitted or empty, ForgeLoop seamlessly falls back to deterministic
# offline models (ideal for offline demos, testing, or rate-limited environments).
GROQ_API_KEY=gsk_your_groq_api_key_here

# Backend Server Port (Optional, defaults to 3000 or platform-assigned port)
PORT=3000
